{"nodes": [{"id": "readme", "label": "README: Hamburgheria del Contadino Fidelity card & CRM", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_hamburgheria_del_contadino", "label": "Hamburgheria del Contadino (restaurant)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_fidelity_programme", "label": "Fidelity Loyalty Programme Rules", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "1 point per EUR paid times tier bonus, rounded down; amounts stored as integer cents so totals are exact; each receipt stores tier and points applied at recording time."}, {"id": "readme_tier_germoglio", "label": "Germoglio tier (the sprout)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New customers, from first visit, x1 points; bottle green and cream with sprouts over furrows. Tier names follow the life of a field, matching Contadino (farmer)."}, {"id": "readme_tier_raccolto", "label": "Raccolto tier (the harvest)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Regular customers from EUR 250 spent, x1.25; roasted chestnut with wheat sheaf."}, {"id": "readme_tier_riserva", "label": "Riserva tier (the reserve)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "VIP from EUR 600 spent, x1.5; black with gold foil border, guilloche rosette and crest."}, {"id": "readme_rewards", "label": "Rewards (fries 80pt, tiramisu 120pt, burger 200pt)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_customer_segments", "label": "Customer Segments (At risk, New, VIP, Regular)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At risk = no visit 45+ days; New = member <=30 days; VIP = EUR400+ or 4+ visits/month."}, {"id": "readme_contactless_nfc_card", "label": "Contactless NFC Wallet Card", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cards carry no QR/barcode; the customer taps the phone at the reader like paying and the card number is sent over NFC (Apple VAS / Google Smart Tap)."}, {"id": "readme_apple_wallet_pass", "label": "Apple Wallet .pkpass", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "iPhone only accepts passes signed with the restaurant Pass Type ID certificate; signed via openssl; NFC payload needs APPLE_NFC_PUBLIC_KEY."}, {"id": "readme_google_wallet_pass", "label": "Google Wallet pass (Smart Tap)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Classes per tier, objects per customer, save links via service-account JWT (RS256); GOOGLE_SMART_TAP enables enableSmartTap."}, {"id": "readme_build_wallet_passes", "label": "tools/build-wallet-passes.js", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_make_fidelity_q